[Unit]
Description=OriginBlame Demo Backend (FastAPI)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/originblame-demo/webapp/backend
EnvironmentFile=/etc/default/webapp
ExecStart=/opt/originblame-demo/webapp/backend/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
